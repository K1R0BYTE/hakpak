# Developer environment of the hakpak dev section. Sourced by zsh (.zshrc
# sources every file here) and, in a Docker Sandbox, by every shell through
# /etc/sandbox-persistent.sh, so it must stay valid in both bash and zsh.
# Each part does nothing when its tool isn't installed.

# Tool directories, added once and only when they exist.
_hakpak_path() {
    [ -d "$1" ] || return 0
    case ":$PATH:" in
        *":$1:"*) ;;
        *) PATH="$PATH:$1" ;;
    esac
}
export FNM_DIR="$HOME/.local/share/fnm"
_hakpak_path /usr/local/go/bin
_hakpak_path /opt/go/bin
_hakpak_path "$HOME/.local/bin"                 # uv tools, fd
_hakpak_path "$HOME/.cargo/bin"                 # Rust
_hakpak_path "$FNM_DIR/aliases/default/bin"     # the default Node, with pnpm
unset -f _hakpak_path
export PATH

# npm: no install scripts, exact versions, and no package younger than a
# day (the usual window in which a hijacked release is caught).
export NPM_CONFIG_IGNORE_SCRIPTS=true
export NPM_CONFIG_AUDIT=true
export NPM_CONFIG_FUND=false
export NPM_CONFIG_SAVE_EXACT=true
export NPM_CONFIG_UPDATE_NOTIFIER=false
export NPM_CONFIG_MINIMUM_RELEASE_AGE=1440
export COREPACK_ENABLE_DOWNLOAD_PROMPT=0
export PYTHONDONTWRITEBYTECODE=1
export PIP_DISABLE_PIP_VERSION_CHECK=1

# fzf lists files with fd: faster, and it skips .git.
if command -v fd >/dev/null 2>&1; then
    export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git'
    export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
    export FZF_ALT_C_COMMAND='fd --type d --hidden --follow --exclude .git'
fi

command -v ast-grep >/dev/null 2>&1 && alias sg=ast-grep
# Claude Code without permission prompts. An alias you type, never a
# default: use it where the machine itself is the sandbox.
alias claude-yolo='claude --dangerously-skip-permissions'

# In an interactive zsh, switch Node version on cd by .nvmrc or .node-version.
case "${ZSH_VERSION:+zsh}$-" in
    zsh*i*) command -v fnm >/dev/null 2>&1 && eval "$(fnm env --use-on-cd --shell zsh)" ;;
esac
